POSTGRES_DB=backendcf
POSTGRES_USER=backendcf
POSTGRES_PASSWORD=change_this_password
# Generar una clave aleatoria de al menos 64 caracteres y conservarla entre reinicios.
# Ejemplo para generarla: openssl rand -base64 48
JWT_SECRET=replace_with_a_persistent_secret_of_at_least_64_characters_long_total
# Clave AES-256 para cifrar el secreto TOTP de MFA; debe decodificar a exactamente 32 bytes
# y conservarse entre reinicios (si cambia, las cuentas con MFA activo pierden el acceso).
# Ejemplo para generarla: openssl rand -base64 32
MFA_ENCRYPTION_KEY=cambia_esto_por_32_bytes_en_base64
